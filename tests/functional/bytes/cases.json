[
  {
    "id": "bytes-raw",
    "group": "bytes",
    "feature": "非 UTF-8 字节可以按字节匹配",
    "operation": "bytes-find",
    "pattern": "(?-u).",
    "text": "ff",
    "extra": [],
    "args": [
      "bytes-find",
      "(?-u).",
      "ff"
    ],
    "expected_stdout": "0\t1\tff\n",
    "expect_error": false,
    "basis": "人工明确预期 + 固定 Rust 版本逐例对照"
  },
  {
