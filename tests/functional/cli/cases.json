[
  {
    "id": "cli-find-match",
    "group": "cli",
    "feature": "命令行匹配协议 match",
    "operation": "cli-find",
    "pattern": "pikevm",
    "text": "-p",
    "extra": [
      "a",
      "-y",
      "za"
    ],
    "args": [
      "cli-find",
      "pikevm",
      "-p",
      "a",
      "-y",
      "za"
    ],
    "expected_stdout": "0:1:2:a\n",
    "expect_error": false,
    "basis": "人工明确预期 + 固定 Rust 版本逐例对照"
  },
