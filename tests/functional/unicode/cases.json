    "pattern": "(?-u:\\d)",
    "text": "٣",
    "extra": [],
    "args": [
      "find",
      "(?-u:\\d)",
      "٣"
    ],
    "expected_stdout": "",
    "expect_error": false,
    "basis": "人工明确预期 + 固定 Rust 版本逐例对照"
  },
  {
    "id": "unicode-fold",
    "group": "unicode",
    "feature": "Kelvin 字符大小写折叠",
    "operation": "find",
    "pattern": "(?i:k)",
    "text": "K",
    "extra": [],
    "args": [
      "find",
      "(?i:k)",
      "K"
    ],
    "expected_stdout": "0\t3\tK\n",
    "expect_error": false,
    "basis": "人工明确预期 + 固定 Rust 版本逐例对照"
  },
  {
    "id": "unicode-absent",
    "group": "unicode",
