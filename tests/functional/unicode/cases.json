[
  {
    "id": "unicode-han",
    "group": "unicode",
    "feature": "汉字属性及字节偏移",
    "operation": "find",
    "pattern": "\\p{Han}+",
    "text": "a中文b",
    "extra": [],
    "args": [
      "find",
      "\\p{Han}+",
      "a中文b"
    ],
    "expected_stdout": "1\t7\t中文\n",
    "expect_error": false,
    "basis": "人工明确预期 + 固定 Rust 版本逐例对照"
  },
  {
    "id": "unicode-digit",
    "group": "unicode",
    "feature": "Unicode 阿拉伯数字",
    "operation": "find",
    "pattern": "\\d",
    "text": "٣",
    "extra": [],
    "args": [
      "find",
      "\\d",
      "٣"
    ],
    "expected_stdout": "0\t2\t٣\n",
    "expect_error": false,
    "basis": "人工明确预期 + 固定 Rust 版本逐例对照"
  },
  {
    "id": "unicode-ascii",
    "group": "unicode",
